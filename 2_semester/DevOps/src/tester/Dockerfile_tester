FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    git=1:2.34.1-1ubuntu1.17 \
    python3=3.10.6-1~22.04.1 \
    python3-pip=22.0.2+dfsg-1ubuntu0.7 \
    patch=2.7.6-7build2 \
    nodejs=12.22.9~dfsg-1ubuntu3.6 \
    npm=8.5.1~ds-1 \
    curl=7.81.0-1ubuntu1.23 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tester

RUN mkdir -p /app && \
    git clone --depth 1 https://github.com/moevm/devops-examples.git /tmp/devops-examples && \
    cp -r /tmp/devops-examples/EXAMPLE_APP/* /app/ && \
    rm -rf /tmp/devops-examples

COPY patches/fix_host.patch /tester/
COPY tester/requirements.txt /tester/
COPY tester/entrypoint.sh /tester/
COPY tester/scripts /tester/scripts

RUN pip3 install --no-cache-dir -r requirements.txt && \
    curl -L https://www.jslint.com/jslint.mjs -o /tester/jslint.mjs && \
    patch /app/main.py < /tester/fix_host.patch && \
    chmod +x /tester/entrypoint.sh && \
    chmod +x /tester/scripts/* 

CMD ["bash", "entrypoint.sh"]
